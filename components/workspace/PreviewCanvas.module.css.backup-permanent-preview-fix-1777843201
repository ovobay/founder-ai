.previewCanvas {
  width: 100%;
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #ffffff;
  color: #111827;
  border: 0;
  border-radius: 30px;
  box-shadow: none;
  box-sizing: border-box;
  position: relative;
}

.previewViewport {
  width: 100%;
  height: 100%;
  min-height: 0;
  flex: 1 1 auto;
  overflow: auto;
  background: #ffffff;
  border: 0;
  border-radius: 30px;
  box-shadow: none;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
  scrollbar-width: thin;
  scrollbar-color: rgba(148, 163, 184, 0.72) transparent;
}

.previewViewport::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

.previewViewport::-webkit-scrollbar-track {
  background: transparent;
}

.previewViewport::-webkit-scrollbar-thumb {
  background: rgba(148, 163, 184, 0.55);
  border: 3px solid transparent;
  border-radius: 999px;
  background-clip: content-box;
}

.previewBorderLayer {
  position: absolute;
  inset: 0;
  z-index: 9999;
  pointer-events: none;
  border-radius: 30px;
  overflow: hidden;
  background: transparent;
}

.loadingState {
  width: 100%;
  height: 100%;
  min-height: 460px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 8px;
  text-align: center;
  background: #ffffff;
  border: 0;
  border-radius: 30px;
  padding: 24px;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.loadingIcon {
  color: #3156f4;
  animation: previewSpin 900ms linear infinite;
}

.loadingState strong {
  color: #111827;
  font-size: 14px;
  font-weight: 850;
  letter-spacing: -0.02em;
}

.loadingState span {
  color: #6b7280;
  font-size: 12px;
  font-weight: 650;
}

@keyframes previewSpin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 760px) {
  .previewCanvas,
  .previewViewport,
  .previewBorderLayer,
  .loadingState {
    border-radius: 22px;
  }
}
